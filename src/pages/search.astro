---
import GenericLayout from '../layouts/GenericLayout.astro';
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";

const pageTitle = "SRA Studio";
const mainTitle = "Search Results";
const subTitle = "搜尋結果";
---
<GenericLayout pageTitle={pageTitle} mainTitle={mainTitle} subTitle={subTitle}>
    <section class="wrapper style3">
        <div class="inner">
            <form id="searchForm">
                <PagefindConfig instance="searchbar" lang="zh-tw" placeholder="Search..."/>
                <pagefind-input instance="searchbar" placeholder="Search..." id="searchbar"></pagefind-input>
                <pagefind-summary instance="searchbar"></pagefind-summary>

            </form>
            <header>
                <p>
                    常用搜尋類別：
                    <a class="icon fa-solid fa-hashtag"></a><a href="/search/?q=map#searchForm">地圖</a>
                    <a class="icon fa-solid fa-hashtag"></a><a href="/search/?q=project#searchForm">專案</a>
                    <a class="icon fa-solid fa-tag"></a><a href="/search/?q=解謎#searchForm">解謎</a>
                    <a class="icon fa-solid fa-tag"></a><a href="/search/?q=多人#searchForm">多人</a>
                </p>
            </header>
            
            <h3></h3>
            <hr />
            <pagefind-result instance="searchbar" id="results"></pagefind-result>
            <p id="none"></p>
        </div>
    </section>
    
    <section class="tiles" id="results">
        
    </section>
</GenericLayout>


<style is:global>
  pagefind-results .pagefind-result {
    display: inline-block;
    width: 300px;
    margin: 1em;
    padding: 1em;
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
  }
  pagefind-results .pagefind-result-title {
    font-size: 1.2em;
    margin-bottom: 0.5em;
  }
  pagefind-results .pagefind-result-excerpt {
    font-size: 0.9em;
    color: #555;
  }
</style>