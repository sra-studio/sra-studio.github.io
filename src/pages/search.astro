---
import GenericLayout from '../layouts/GenericLayout.astro';

const pageTitle = "SRA Studio";
const mainTitle = "Search Results";
const subTitle = "搜尋結果";
---
<GenericLayout pageTitle={pageTitle} mainTitle={mainTitle} subTitle={subTitle}>
    <section class="wrapper style3">
        <div class="inner">
            <form id="searchForm">
                <input type="text" class="searchBox" placeholder="Search..." />
            </form>
            <header>
                <p>
                    常用搜尋類別：
                    <a class="icon fa-solid fa-hashtag"></a><a href="/search/?q=map#searchForm">地圖</a>
                    <a class="icon fa-solid fa-hashtag"></a><a href="/search/?q=project#searchForm">專案</a>
                    <a class="icon fa-solid fa-tag"></a><a href="/search/?q=解謎#searchForm">解謎</a>
                    <a class="icon fa-solid fa-tag"></a><a href="/search/?q=多人#searchForm">多人</a>
                </p>
            </header>
            
            <h3></h3>
            <hr />
            <p id="none"></p>
        </div>
    </section>
    
    <section class="tiles" id="results">
        
    </section>

    <script>
        import '../styles/js/search-page'
    </script>
</GenericLayout>