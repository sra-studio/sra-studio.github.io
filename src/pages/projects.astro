---
import GenericLayout from '../layouts/GenericLayout.astro';
const pageTitle = "SRA Studio";
const mainTitle = "Maps";
const subTitle = "Minecraft地圖集";

import Img_202510_69Land from '../images/projects/202510_69Land/69land.png';
import Img_202510_HauntedHouse from '../images/projects/202510_HauntedHouse/haunted.png';
import Img_202604_EasterEggHunt from '../images/projects/202604_EasterEggHunt/2026-05-02_22.01.45.png';
import Img_202604_Mase from '../images/projects/202604_Maze/2026-04-25_18.47.58.png';
---
<GenericLayout pageTitle={pageTitle} mainTitle={mainTitle} subTitle={subTitle}>
    <section class="tiles">
        <article><a href="/projects/202510_69Land" class="link">
            <span class="image">
                <img src={Img_202510_69Land.src} alt="" />
            </span>
            <header class="major">
                <h3>69 Land</h3>
                <p>69遊樂園 | 客製化遊樂園地圖</p>
            </header>
        </a></article>

        <article><a href="/projects/202510_HauntedHouse" class="link">
            <span class="image">
                <img src={Img_202510_HauntedHouse.src} alt="" />
            </span>
            <header class="major">
                <h3>Haunted House</h3>
                <p>陸玖大宅 | 萬聖節鬼屋</p>
            </header>
        </a></article>

        <article><a href="/projects/202604_EasterEggHunt" class="link">
            <span class="image">
                <img src={Img_202604_EasterEggHunt.src} alt="" />
            </span>
            <header class="major">
                <h3>Easter Egg Hunt</h3>
                <p>修蛋幾勒 | 復活節找蛋活動</p>
            </header>
        </a></article>

        <article><a href="/projects/202604_Maze" class="link">
            <span class="image">
                <img src={Img_202604_Mase.src} alt="" />
            </span>
            <header class="major">
                <h3>Maze</h3>
                <p>咪宮 | 遊樂園迷宮</p>
            </header>
        </a></article>

    </section>
</GenericLayout>