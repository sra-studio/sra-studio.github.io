---
import { Image } from 'astro:assets';
import GenericLayout from '../layouts/GenericLayout.astro';
import { projects, projectUrl } from '../data/projects';
const pageTitle = "SRA Studio";
const mainTitle = "Projects";
const subTitle = "Minecraft專案";
const description = "SRA Studio 的 Minecraft 專案與活動作品集。";

---
<GenericLayout pageTitle={pageTitle} mainTitle={mainTitle} subTitle={subTitle} description={description}>
    <section class="tiles">
        {projects.map((project) => (
            <article><a href={projectUrl(project)} class="link">
                <span class="image">
                    <Image src={project.cover} alt="" width={1280} widths={[640, 960, 1280]} sizes="(max-width: 736px) 100vw, 60vw" />
                </span>
                <header class="major">
                    <h3>{project.title}</h3>
                    <p>{project.subtitle} | {project.summary}</p>
                </header>
            </a></article>
        ))}
    </section>
</GenericLayout>