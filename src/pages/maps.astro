---
import { Image } from 'astro:assets';
import GenericLayout from '../layouts/GenericLayout.astro';
import { maps, mapUrl } from '../data/maps';
const pageTitle = "SRA Studio";
const mainTitle = "Maps";
const subTitle = "Minecraft地圖集";
const description = "SRA Studio 製作的 Minecraft 地圖集。";

---
<GenericLayout pageTitle={pageTitle} mainTitle={mainTitle} subTitle={subTitle} description={description}>
    <section class="tiles">
        {maps.map((gameMap) => (
            <article><a href={mapUrl(gameMap)} class="link">
                <span class="image">
                    <Image src={gameMap.cover} alt="" />
                </span>
                <header class="major">
                    <h3>{gameMap.title}</h3>
                    <p>{gameMap.subtitle}</p>
                </header>
            </a></article>
        ))}
    </section>
</GenericLayout>