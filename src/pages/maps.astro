---
import BaseLayout from '../layouts/BaseLayout.astro';

const bodyHtml = `<!-- Page Wrapper -->
			<div id="page-wrapper">

				<!-- Header -->
					<header id="header">
						<h1><a href="/">SRA Studio</a></h1>
						<nav id="nav">
							<ul>
								<li class="special">
									<a href="#menu" class="menuToggle"><span>Menu</span></a>
									<div id="menu">
										<ul>
											<li><input type="text" class="searchBox" placeholder="Search..." /></li>

											<li><a href="/">Home</a></li>
											<li><a href="/projects">Projects</a></li>
                                            <li><a href="/maps">Maps</a></li>
										</ul>
									</div>
								</li>
							</ul>
						</nav>
					</header>

				<!-- Main -->
					<article id="main">
						<header class="default">
							<h2>Maps</h2>
							<p>Minecraft地圖集</p>
						</header>
							<section class="tiles">
								<article><a href="/maps/202608_LostDreamlandParadise/" class="link">
									<span class="image">
										<img src="/src/assets/images/pic01.jpg" alt="" />
									</span>
									<header class="major">
										<h3>Lost Dreamland Paradise</h3>
										<p>失落的夢境樂園</p>
									</header>
								</a></article>

								<article><a href="/maps/202510_HauntedHouse/" class="link">
									<span class="image">
										<img src="/src/assets/images/pic02.jpg" alt="" />
									</span>
									<header class="major">
										<h3>Haunted House</h3>
										<p>鬼屋</p>
									</header>
								</a></article>

							</section>
					</article>

				<!-- Footer -->
					<footer id="footer">
						<ul class="icons">
							<li><a href="https://github.com/sra-studio" class="icon fa-brands fa-github" target="_blank" rel="noopener noreferrer"><span class="label">Github</span></a></li>
							<li><a href="https://forms.gle/6JYrZwiZPHqsZ7ZB6" class="icon fa-solid fa-paper-plane" target="_blank" rel="noopener noreferrer"><span class="label">Contact</span></a></li>
						</ul>
						<ul class="copyright">
							<li>&copy; 2026 SRA Studio. All rights reserved.</li><li>Page Design: <a href="http://html5up.net">HTML5 UP</a></li>
						</ul>
					</footer>

			</div>
		
		<div class="scroll-buttons">
			<a href="#main" class="icon fa-solid fa-up-long more scrolly"><span class="label">Scroll Up</span></a>
			<a href="#footer" class="icon fa-solid fa-down-long more scrolly"><span class="label">Scroll Down</span></a>
		</div>`;
---
<BaseLayout
  title="SRA Studio | Maps"
  bodyClass="is-preload"
  includeCopyText={false}
  includeBackground={false}
  includeSearchPage={false}
  includeCopyCode={false}
  includeSpoilerToggle={false}
>
  <Fragment set:html={bodyHtml} />
</BaseLayout>
