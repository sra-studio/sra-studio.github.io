---
import GenericLayout from '../layouts/GenericLayout.astro';
const pageTitle = "SRA Studio";
const mainTitle = "Maps";
const subTitle = "Minecraft地圖集";

import Pic01 from '../images/pic01.jpg';
import Pic02 from '../images/pic02.jpg';
---
<GenericLayout pageTitle={pageTitle} mainTitle={mainTitle} subTitle={subTitle}>
    <section class="tiles">
        <article><a href="/maps/202608_LostDreamlandParadise" class="link">
            <span class="image">
                <img src={Pic01.src} alt="" />
            </span>
            <header class="major">
                <h3>Lost Dreamland Paradise</h3>
                <p>失落的夢境樂園</p>
            </header>
        </a></article>

        <article><a href="/maps/202510_HauntedHouse" class="link">
            <span class="image">
                <img src={Pic02.src} alt="" />
            </span>
            <header class="major">
                <h3>Haunted House</h3>
                <p>鬼屋</p>
            </header>
        </a></article>

    </section>
</GenericLayout>