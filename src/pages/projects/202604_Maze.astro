---
import { Image } from 'astro:assets';
import GenericLayout from '../../layouts/GenericLayout.astro';
import ServerInfo from '../../components/69ClubServer.astro';
const pageTitle = "SRA Studio | Projects";
const mainTitle = "Maze";
const subTitle = "咪宮";

import Img1 from '../../images/projects/202604_Maze/2026-04-25_18.47.58.png';
import Img2 from '../../images/projects/202604_Maze/2026-04-25_18.48.19.png';
import Img3 from '../../images/projects/202604_Maze/2026-04-25_18.50.06.png';
import Img4 from '../../images/projects/202604_Maze/2026-04-25_18.50.26.png';
import Img5 from '../../images/projects/202604_Maze/2026-04-25_18.51.02.png';
import Img6 from '../../images/projects/202604_Maze/2026-04-25_18.53.21.png';
import Img7 from '../../images/projects/202604_Maze/2026-04-25_19.01.44.png';
import Img8 from '../../images/projects/202604_Maze/2026-04-25_19.01.51.png';
import Img9 from '../../images/projects/202604_Maze/2026-04-25_19.04.24.png';
import Img10 from '../../images/projects/202604_Maze/2026-04-25_19.08.05.png';

---
<GenericLayout pageTitle={pageTitle} mainTitle={mainTitle} subTitle={subTitle}>
    <section class="wrapper style5">
        <div class="inner">
            <h3>Introduction</h3>
            <p>
                位於六九社伺服器的遊樂園服<br />
                輕鬆導向的遊樂設施<br />
                平均遊玩時長為1小時(含找齊所有成就)
            </p>

            <p>
                <a class="icon fa-solid fa-calendar-days" title="活動日期"></a> 2026/04/15-無限期（含限時成就，領取期限2026/05/15）<br />
                <a class="icon fa-solid fa-location-dot"></a>  <a href="#server-info" class="more scrolly no-underline content-link">69社伺服器</a><br />
                <br />
                <a class="icon fa-solid fa-hashtag"></a> 建築、指令方塊
            </p>

            <hr />
            <header>
            <h4>Images</h4>
                <p>使用光影模組（Complementary Shaders - Unbound）拍攝</p>
            </header>
            <div class="box alt">
                <div class="row gtr-50 gtr-uniform">
                    <div class="col-12"><span class="image fit"><Image src={Img1} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><Image src={Img2} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><Image src={Img3} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><Image src={Img4} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><Image src={Img5} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><Image src={Img6} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><Image src={Img7} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><Image src={Img8} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><Image src={Img9} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><Image src={Img10} alt="" /></span></div>
                </div>
            </div>
            
            <hr />
            <h4>CREDITS</h4>
            <table>
            <tr>
                <th>成員</th>
                <th>工作內容</th>
            </tr>
            <tr>
                <td>安妮 (annielllovo)</td>
                <td>建築設計、創意發想</td>
            </tr>
            <tr>
                <td>Joy (joy40217)</td>
                <td>指令撰寫、道具製作</td>
            </tr>
            <tr>
                <td>蘑菇 (lups90)</td>
                <td>整體細節調整</td>
            </tr>
            </table>

            <hr />
            <ServerInfo />
        </div>
    </section>
</GenericLayout>