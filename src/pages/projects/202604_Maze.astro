---
import GenericLayout from '../../layouts/GenericLayout.astro';
import Gallery from '../../components/Gallery.astro';
import ServerInfo from '../../components/69ClubServer.astro';
import { getProject } from '../../data/projects';
const pageTitle = "SRA Studio | Projects";

// 名稱、簡介、封面圖、日期、標籤等基本資料集中在 src/data/projects.ts
const project = getProject('202604_Maze');

import Img1 from '../../images/projects/202604_Maze/2026-04-25_18.47.58.webp';
import Img2 from '../../images/projects/202604_Maze/2026-04-25_18.48.19.webp';
import Img3 from '../../images/projects/202604_Maze/2026-04-25_18.50.06.webp';
import Img4 from '../../images/projects/202604_Maze/2026-04-25_18.50.26.webp';
import Img5 from '../../images/projects/202604_Maze/2026-04-25_18.51.02.webp';
import Img6 from '../../images/projects/202604_Maze/2026-04-25_18.53.21.webp';
import Img7 from '../../images/projects/202604_Maze/2026-04-25_19.01.44.webp';
import Img8 from '../../images/projects/202604_Maze/2026-04-25_19.01.51.webp';
import Img9 from '../../images/projects/202604_Maze/2026-04-25_19.04.24.webp';
import Img10 from '../../images/projects/202604_Maze/2026-04-25_19.08.05.webp';

---
<GenericLayout pageTitle={pageTitle} mainTitle={project.title} subTitle={project.subtitle} description={project.description} image={project.cover} imagePosition={project.coverPosition}>
    <section class="wrapper style5">
        <div class="inner">
            <h3>Introduction</h3>
            <p>
                位於六九社伺服器的遊樂園服<br />
                輕鬆導向的遊樂設施<br />
                平均遊玩時長為1小時(含找齊所有成就)
            </p>

            <p>
                <span class="icon fa-solid fa-calendar-days" title="活動日期"></span> {project.period}（含限時成就，領取期限2026/05/15）<br />
                <span class="icon fa-solid fa-location-dot"></span>  <a href="#server-info" class="more scrolly no-underline content-link">{project.location}</a><br />
                <br />
                <span class="icon fa-solid fa-hashtag"></span> {project.tags}
            </p>

            <hr />
            <header>
            <h4>Images</h4>
                <p>使用光影模組（Complementary Shaders - Unbound）拍攝</p>
            </header>
            <Gallery title={project.title} images={[Img1, Img2, Img3, Img4, Img5, Img6, Img7, Img8, Img9, Img10]} />
            
            <hr />
            <h4>CREDITS</h4>
            <table>
            <tr>
                <th>成員</th>
                <th>工作內容</th>
            </tr>
            <tr>
                <td>安妮 (annielllovo)</td>
                <td>建築設計、創意發想</td>
            </tr>
            <tr>
                <td>Joy (joy40217)</td>
                <td>指令撰寫、道具製作</td>
            </tr>
            <tr>
                <td>蘑菇 (lups90)</td>
                <td>整體細節調整</td>
            </tr>
            </table>

            <hr />
            <ServerInfo />
        </div>
    </section>
</GenericLayout>