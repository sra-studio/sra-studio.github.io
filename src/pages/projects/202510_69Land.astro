---
import GenericLayout from '../../layouts/GenericLayout.astro';
import ServerInfo from '../../components/69ClubServer.astro';
const pageTitle = "SRA Studio | Projects";
const mainTitle = "69 Land";
const subTitle = "六九遊樂園";

import Img1 from '../../images/projects/202510_69Land/2026-04-25_20.28.22.png';
import Img2 from '../../images/projects/202510_69Land/2026-04-25_20.21.36.png';
import Img3 from '../../images/projects/202510_69Land/2026-04-25_20.23.10.png';
import Img4 from '../../images/projects/202510_69Land/2026-04-25_20.24.46.png';
import Img5 from '../../images/projects/202510_69Land/2026-04-25_20.25.02.png';
import Img6 from '../../images/projects/202510_69Land/2026-04-25_20.25.23.png';
import Img7 from '../../images/projects/202510_69Land/2026-04-25_20.26.11.png';
import Img8 from '../../images/projects/202510_69Land/2026-04-25_20.26.38.png';
import Img9 from '../../images/projects/202510_69Land/2026-04-25_20.27.02.png';
import Img10 from '../../images/projects/202510_69Land/2026-04-25_20.27.17.png';
---
<GenericLayout pageTitle={pageTitle} mainTitle={mainTitle} subTitle={subTitle}>
    <section class="wrapper style5">
        <div class="inner">
            <h3>Introduction</h3>
            <p>
                位於六九社伺服器的遊樂園服<br />
                為遊樂園之主建築<br />
                不定時會舉辦各種活動並推出新的遊樂設施
            </p>

            <p>
                <a class="icon fa-solid fa-calendar-days" title="活動日期"></a> 2025/10/26-無限期<br />
                <a class="icon fa-solid fa-location-dot"></a> <a href="#server-info" class="more scrolly no-underline content-link">69社伺服器</a><br />
                <br />
                <a class="icon fa-solid fa-hashtag"></a> 建築
            </p>

            <hr />
            <header>
            <h4>Images</h4>
                <p>使用光影模組（Complementary Shaders - Unbound）拍攝</p>
            </header>
            <div class="box alt">
                <div class="row gtr-50 gtr-uniform">
                    <div class="col-12"><span class="image fit"><img src={Img1.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img2.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img3.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img4.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img5.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img6.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img7.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img8.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img9.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img10.src} alt="" /></span></div>
                </div>
            </div>

            <hr />
            <h4>CREDITS</h4>
            <table>
            <tr>
                <th>成員</th>
                <th>工作內容</th>
            </tr>
            <tr>
                <td>安妮 (annielllovo)</td>
                <td>建築設計</td>
            </tr>
            <tr>
                <td>Joy (joy40217)</td>
                <td>細節調整</td>
            </tr>
            <tr>
                <td>蘑菇 (lups90)</td>
                <td>細節調整</td>
            </tr>
            </table>

            <hr />
            <ServerInfo />
        </div>
    </section>
</GenericLayout>