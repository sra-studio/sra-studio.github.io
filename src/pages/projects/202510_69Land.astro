---
import GenericLayout from '../../layouts/GenericLayout.astro';
import Gallery from '../../components/Gallery.astro';
import ServerInfo from '../../components/69ClubServer.astro';
import { getProject } from '../../data/projects';
const pageTitle = "SRA Studio | Projects";

// 名稱、簡介、封面圖、日期、標籤等基本資料集中在 src/data/projects.ts
const project = getProject('202510_69Land');

import Img1 from '../../images/projects/202510_69Land/2026-04-25_20.28.22.webp';
import Img2 from '../../images/projects/202510_69Land/2026-04-25_20.21.36.webp';
import Img3 from '../../images/projects/202510_69Land/2026-04-25_20.23.10.webp';
import Img4 from '../../images/projects/202510_69Land/2026-04-25_20.24.46.webp';
import Img5 from '../../images/projects/202510_69Land/2026-04-25_20.25.02.webp';
import Img6 from '../../images/projects/202510_69Land/2026-04-25_20.25.23.webp';
import Img7 from '../../images/projects/202510_69Land/2026-04-25_20.26.11.webp';
import Img8 from '../../images/projects/202510_69Land/2026-04-25_20.26.38.webp';
import Img9 from '../../images/projects/202510_69Land/2026-04-25_20.27.02.webp';
import Img10 from '../../images/projects/202510_69Land/2026-04-25_20.27.17.webp';
---
<GenericLayout pageTitle={pageTitle} mainTitle={project.title} subTitle={project.subtitle} description={project.description} image={project.cover} imagePosition={project.coverPosition}>
    <section class="wrapper style5">
        <div class="inner">
            <h3>Introduction</h3>
            <p>
                位於六九社伺服器的遊樂園服<br />
                為遊樂園之主建築<br />
                不定時會舉辦各種活動並推出新的遊樂設施
            </p>

            <p>
                <span class="icon fa-solid fa-calendar-days" title="活動日期"></span> {project.period}<br />
                <span class="icon fa-solid fa-location-dot"></span> <a href="#server-info" class="more scrolly no-underline content-link">{project.location}</a><br />
                <br />
                <span class="icon fa-solid fa-hashtag"></span> {project.tags}
            </p>

            <hr />
            <header>
            <h4>Images</h4>
                <p>使用光影模組（Complementary Shaders - Unbound）拍攝</p>
            </header>
            <Gallery title={project.title} images={[Img1, Img2, Img3, Img4, Img5, Img6, Img7, Img8, Img9, Img10]} />

            <hr />
            <h4>CREDITS</h4>
            <table>
            <tr>
                <th>成員</th>
                <th>工作內容</th>
            </tr>
            <tr>
                <td>安妮 (annielllovo)</td>
                <td>建築設計</td>
            </tr>
            <tr>
                <td>Joy (joy40217)</td>
                <td>細節調整</td>
            </tr>
            <tr>
                <td>蘑菇 (lups90)</td>
                <td>細節調整</td>
            </tr>
            </table>

            <hr />
            <ServerInfo />
        </div>
    </section>
</GenericLayout>