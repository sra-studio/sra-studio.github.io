---
import GenericLayout from '../../layouts/GenericLayout.astro';
import ServerInfo from '../../components/69ClubServer.astro';
const pageTitle = "SRA Studio | Projects";
const mainTitle = "Easter Egg Hunt";
const subTitle = "修蛋幾勒";

import Img1 from '../../images/projects/202604_EasterEggHunt/2026-05-02_22.01.45.png';
import Img2 from '../../images/projects/202604_EasterEggHunt/2026-05-02_22.01.09.png';
import Img3 from '../../images/projects/202604_EasterEggHunt/2026-05-02_22.02.25.png';
import Img4 from '../../images/projects/202604_EasterEggHunt/2026-05-02_22.02.48.png';
import Img5 from '../../images/projects/202604_EasterEggHunt/2026-05-02_22.03.24.png';
import Img6 from '../../images/projects/202604_EasterEggHunt/2026-05-02_22.04.04.png';
import Img7 from '../../images/projects/202604_EasterEggHunt/2026-05-02_22.04.44.png';
import Img8 from '../../images/projects/202604_EasterEggHunt/2026-05-02_22.05.08.png';
import Img9 from '../../images/projects/202604_EasterEggHunt/2026-05-02_22.05.47.png';
import Img10 from '../../images/projects/202604_EasterEggHunt/2026-05-02_22.09.32.png';

---
<GenericLayout pageTitle={pageTitle} mainTitle={mainTitle} subTitle={subTitle}>
    <section class="wrapper style5">
        <div class="inner">
            <h3>Introduction</h3>
            <p>
                於六九社伺服器的遊樂園服舉辦的復活節找蛋活動<br />
                使用資料包判定及記錄玩家找蛋的進度<br />
                並在玩家找齊所有復活蛋時自動發放獎勵
            </p>

            <p>
                <a class="icon fa-solid fa-calendar-days" title="活動日期"></a> 2026/04/05-2026/04/30<br />
                <a class="icon fa-solid fa-location-dot"></a>  <a href="#server-info" class="more scrolly no-underline content-link">69社伺服器</a><br />
                <br />
                <a class="icon fa-solid fa-hashtag"></a> 資料包
            </p>

            <hr />
            <header>
            <h4>Images</h4>
                <p>使用光影模組（Complementary Shaders - Unbound）拍攝</p>
            </header>
            <div class="box alt">
                <div class="row gtr-50 gtr-uniform">
                    <div class="col-12"><span class="image fit"><img src={Img1.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img2.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img3.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img4.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img5.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img6.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img7.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img8.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img9.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img10.src} alt="" /></span></div>
                </div>
            </div>
            
            <hr />
            <h4>CREDITS</h4>
            <table>
            <tr>
                <th>成員</th>
                <th>工作內容</th>
            </tr>
            <tr>
                <td>Joy (joy40217)</td>
                <td>指令撰寫、道具製作</td>
            </tr>
            </table>

            <hr />
            <ServerInfo />
        </div>
    </section>
</GenericLayout>