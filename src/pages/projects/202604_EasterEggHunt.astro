---
import GenericLayout from '../../layouts/GenericLayout.astro';
import Gallery from '../../components/Gallery.astro';
import ServerInfo from '../../components/69ClubServer.astro';
import { getProject } from '../../data/projects';
const pageTitle = "SRA Studio | Projects";

// 名稱、簡介、封面圖、日期、標籤等基本資料集中在 src/data/projects.ts
const project = getProject('202604_EasterEggHunt');

import Img1 from '../../images/projects/202604_EasterEggHunt/2026-05-02_22.01.45.webp';
import Img2 from '../../images/projects/202604_EasterEggHunt/2026-05-02_22.01.09.webp';
import Img3 from '../../images/projects/202604_EasterEggHunt/2026-05-02_22.02.25.webp';
import Img4 from '../../images/projects/202604_EasterEggHunt/2026-05-02_22.02.48.webp';
import Img5 from '../../images/projects/202604_EasterEggHunt/2026-05-02_22.03.24.webp';
import Img6 from '../../images/projects/202604_EasterEggHunt/2026-05-02_22.04.04.webp';
import Img7 from '../../images/projects/202604_EasterEggHunt/2026-05-02_22.04.44.webp';
import Img8 from '../../images/projects/202604_EasterEggHunt/2026-05-02_22.05.08.webp';
import Img9 from '../../images/projects/202604_EasterEggHunt/2026-05-02_22.05.47.webp';
import Img10 from '../../images/projects/202604_EasterEggHunt/2026-05-02_22.09.32.webp';

---
<GenericLayout pageTitle={pageTitle} mainTitle={project.title} subTitle={project.subtitle} description={project.description} image={project.cover} imagePosition={project.coverPosition}>
    <section class="wrapper style5">
        <div class="inner">
            <h3>Introduction</h3>
            <p>
                於六九社伺服器的遊樂園服舉辦的復活節找蛋活動<br />
                使用資料包判定及記錄玩家找蛋的進度<br />
                並在玩家找齊所有復活蛋時自動發放獎勵
            </p>

            <p>
                <span class="icon fa-solid fa-calendar-days" title="活動日期"></span> {project.period}<br />
                <span class="icon fa-solid fa-location-dot"></span>  <a href="#server-info" class="more scrolly no-underline content-link">{project.location}</a><br />
                <br />
                <span class="icon fa-solid fa-hashtag"></span> {project.tags}
            </p>

            <hr />
            <header>
            <h4>Images</h4>
                <p>使用光影模組（Complementary Shaders - Unbound）拍攝</p>
            </header>
            <Gallery title={project.title} images={[Img1, Img2, Img3, Img4, Img5, Img6, Img7, Img8, Img9, Img10]} />
            
            <hr />
            <h4>CREDITS</h4>
            <table>
            <tr>
                <th>成員</th>
                <th>工作內容</th>
            </tr>
            <tr>
                <td>Joy (joy40217)</td>
                <td>指令撰寫、道具製作</td>
            </tr>
            </table>

            <hr />
            <ServerInfo />
        </div>
    </section>
</GenericLayout>