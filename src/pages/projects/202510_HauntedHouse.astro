---
import GenericLayout from '../../layouts/GenericLayout.astro';
import ServerInfo from '../../components/69ClubServer.astro';
const pageTitle = "SRA Studio | Projects";
const mainTitle = "Haunted House";
const subTitle = "陸玖大宅";

import Img1 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.42.04.png';
import Img2 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.35.39.png';
import Img3 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.41.41.png';
import Img4 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.38.03.png';
import Img5 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.38.18.png';
import Img6 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.38.30.png';
import Img7 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.38.42.png';
import Img8 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.39.19.png';
import Img9 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.39.30.png';
import Img10 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.39.41.png';
import Img11 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.40.25.png';
import Img12 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.40.50.png';
import Img13 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.41.00.png';
import Img14 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.34.38.png';
import Img15 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.34.10.png';
import Img16 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.34.21.png';

---
<GenericLayout pageTitle={pageTitle} mainTitle={mainTitle} subTitle={subTitle}>
    <section class="wrapper style5">
        <div class="inner">
            <h3>Introduction</h3>
            <p>
                位於六九社伺服器的遊樂園服<br />
                是開服的第一個遊樂設施<br />
                與萬聖節活動共同推出<br />
                目前因伺服器效能問題暫時定為限時開放的設施<br />
                待伺服器版本升級及指令效能優化後將會重新開放<br />
            </p>

            <p>
                <a class="icon fa-solid fa-calendar-days" title="活動日期"></a> 2025/10/26-2025/11/31<br />
                <a class="icon fa-solid fa-location-dot"></a>  <a href="#server-info" class="more scrolly no-underline content-link">69社伺服器</a><br />
                <br />
                <a class="icon fa-solid fa-hashtag"></a> 建築、指令方塊
            </p>

            <hr />
            <header>
            <h4>Images</h4>
                <p>使用光影模組（Complementary Shaders - Unbound）拍攝</p>
            </header>
            <div class="box alt">
                <div class="row gtr-50 gtr-uniform">
                    <div class="col-12"><span class="image fit"><img src={Img1.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img2.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img3.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img4.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img5.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img6.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img7.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img8.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img9.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img10.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img11.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img12.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img13.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img14.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img15.src} alt="" /></span></div>
                    <div class="col-4"><span class="image fit"><img src={Img16.src} alt="" /></span></div>
                </div>
            </div>
            
            <hr />
            <h4>CREDITS</h4>
            <table>
            <tr>
                <th>成員</th>
                <th>工作內容</th>
            </tr>
            <tr>
                <td>安妮 (annielllovo)</td>
                <td>建築設計、劇情發想</td>
            </tr>
            <tr>
                <td>Joy (joy40217)</td>
                <td>指令撰寫、音效設計、道具製作</td>
            </tr>
            <tr>
                <td>蘑菇 (lups90)</td>
                <td>整體細節調整</td>
            </tr>
            </table>

            <hr />
            <ServerInfo />
        </div>
    </section>
</GenericLayout>