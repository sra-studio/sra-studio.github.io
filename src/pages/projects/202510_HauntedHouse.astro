---
import GenericLayout from '../../layouts/GenericLayout.astro';
import Gallery from '../../components/Gallery.astro';
import ServerInfo from '../../components/69ClubServer.astro';
import { getProject } from '../../data/projects';
const pageTitle = "SRA Studio | Projects";

// 名稱、簡介、封面圖、日期、標籤等基本資料集中在 src/data/projects.ts
const project = getProject('202510_HauntedHouse');

import Img1 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.42.04.webp';
import Img2 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.35.39.webp';
import Img3 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.41.41.webp';
import Img4 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.38.03.webp';
import Img5 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.38.18.webp';
import Img6 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.38.30.webp';
import Img7 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.38.42.webp';
import Img8 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.39.19.webp';
import Img9 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.39.30.webp';
import Img10 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.39.41.webp';
import Img11 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.40.25.webp';
import Img12 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.40.50.webp';
import Img13 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.41.00.webp';
import Img14 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.34.38.webp';
import Img15 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.34.10.webp';
import Img16 from '../../images/projects/202510_HauntedHouse/2026-04-25_20.34.21.webp';

---
<GenericLayout pageTitle={pageTitle} mainTitle={project.title} subTitle={project.subtitle} description={project.description} image={project.cover} imagePosition={project.coverPosition}>
    <section class="wrapper style5">
        <div class="inner">
            <h3>Introduction</h3>
            <p>
                位於六九社伺服器的遊樂園服<br />
                是開服的第一個遊樂設施<br />
                與萬聖節活動共同推出<br />
                目前因伺服器效能問題暫時定為限時開放的設施<br />
                待伺服器版本升級及指令效能優化後將會重新開放<br />
            </p>

            <p>
                <span class="icon fa-solid fa-calendar-days" title="活動日期"></span> {project.period}<br />
                <span class="icon fa-solid fa-location-dot"></span>  <a href="#server-info" class="more scrolly no-underline content-link">{project.location}</a><br />
                <br />
                <span class="icon fa-solid fa-hashtag"></span> {project.tags}
            </p>

            <hr />
            <header>
            <h4>Images</h4>
                <p>使用光影模組（Complementary Shaders - Unbound）拍攝</p>
            </header>
            <Gallery title={project.title} images={[Img1, Img2, Img3, Img4, Img5, Img6, Img7, Img8, Img9, Img10, Img11, Img12, Img13, Img14, Img15, Img16]} />
            
            <hr />
            <h4>CREDITS</h4>
            <table>
            <tr>
                <th>成員</th>
                <th>工作內容</th>
            </tr>
            <tr>
                <td>安妮 (annielllovo)</td>
                <td>建築設計、劇情發想</td>
            </tr>
            <tr>
                <td>Joy (joy40217)</td>
                <td>指令撰寫、音效設計、道具製作</td>
            </tr>
            <tr>
                <td>蘑菇 (lups90)</td>
                <td>整體細節調整</td>
            </tr>
            </table>

            <hr />
            <ServerInfo />
        </div>
    </section>
</GenericLayout>