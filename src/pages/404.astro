---
import GenericLayout from '../layouts/GenericLayout.astro';
const pageTitle = "SRA Studio";
const mainTitle = "404";
const subTitle = "Page Not Found";
---
<GenericLayout pageTitle={pageTitle} mainTitle={mainTitle} subTitle={subTitle}>
    <section class="wrapper style5">
        <div class="inner">
            <p>你所查詢的網頁目前不存在，若有疑問，請<a href="https://forms.gle/6JYrZwiZPHqsZ7ZB6">聯絡我們</a></p>
            <hr />
        </div>
    </section>
</GenericLayout>