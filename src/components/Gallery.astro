---
// 圖片畫廊：第一張是大圖，其餘是三欄縮圖；點擊任一張會以燈箱顯示大圖。
// 用法：<Gallery title={mainTitle} images={[Img1, Img2, Img3]} />
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	images: ImageMetadata[];
	/** 專案名稱，用來產生圖片的替代文字 */
	title?: string;
}

const { images, title = '' } = Astro.props;

// 燈箱大圖的寬度上限（原圖比較小時不會放大）
const FULL_WIDTH = 1920;

// widths：建置時要產生的寬度；sizes：告訴瀏覽器這張圖在版面上實際有多寬
const HERO = {
	column: 'col-12',
	widths: [480, 960, 1280, 1920],
	sizes: '(max-width: 1280px) 90vw, (max-width: 1680px) 1040px, 1200px',
};
const THUMB = {
	column: 'col-4',
	widths: [240, 480, 720],
	sizes: '(max-width: 1280px) 30vw, (max-width: 1680px) 340px, 390px',
};

const label = title ? `${title} 截圖` : '截圖';

const items = await Promise.all(
	images.map(async (src, index) => {
		const preset = index === 0 ? HERO : THUMB;
		const largest = preset.widths[preset.widths.length - 1];
		const full = await getImage({ src, width: Math.min(src.width, FULL_WIDTH) });
		return {
			src,
			href: full.src,
			column: preset.column,
			width: Math.min(src.width, largest),
			widths: [...preset.widths],
			sizes: preset.sizes,
			alt: `${label} ${index + 1}`,
		};
	}),
);
---

<div class="box alt gallery" data-gallery>
	<div class="row gtr-50 gtr-uniform">
		{items.map((item) => (
			<div class={item.column}>
				<a class="image fit gallery-item" href={item.href} data-gallery-item>
					<Image src={item.src} alt={item.alt} width={item.width} widths={item.widths} sizes={item.sizes} />
				</a>
			</div>
		))}
	</div>

	<dialog class="lightbox" data-lightbox aria-label={`${label}檢視`}>
		<img class="lightbox-image" data-lightbox-image src={items[0]?.href} alt="" loading="lazy" decoding="async" />
		<button type="button" class="lightbox-button lightbox-close" data-lightbox-close aria-label="關閉">
			<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
		</button>
		<button type="button" class="lightbox-button lightbox-prev" data-lightbox-prev aria-label="上一張">
			<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
		</button>
		<button type="button" class="lightbox-button lightbox-next" data-lightbox-next aria-label="下一張">
			<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
		</button>
		<div class="lightbox-counter" data-lightbox-counter aria-live="polite"></div>
	</dialog>
</div>

<style>
	/* 選擇器刻意寫成三層 class，才能蓋過模板的 `.wrapper.style5 button` 等全域樣式 */

	.gallery .gallery-item {
		cursor: zoom-in;
	}

	.gallery .gallery-item:focus-visible {
		outline: 2px solid #21b2a6;
		outline-offset: 2px;
	}

	.gallery .lightbox {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		overflow: hidden;
		background: rgba(0, 0, 0, 0.92);
		color: #fff;
	}

	/* display 只在開啟時設定，否則會蓋掉瀏覽器「未開啟的 dialog 不顯示」的預設 */
	.gallery .lightbox[open] {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.gallery .lightbox::backdrop {
		background: rgba(0, 0, 0, 0.92);
	}

	.gallery .lightbox .lightbox-image {
		display: block;
		width: auto;
		height: auto;
		max-width: 100vw;
		max-height: calc(100vh - 7rem);
		max-height: calc(100dvh - 7rem);
		border-radius: 3px;
		transition: opacity 0.2s ease;
	}

	.gallery .lightbox .lightbox-image.is-loading {
		opacity: 0.4;
	}

	.gallery .lightbox .lightbox-button {
		all: unset;
		box-sizing: border-box;
		position: absolute;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		background-color: rgba(0, 0, 0, 0.5);
		cursor: pointer;
		transition: background-color 0.2s ease;
		-webkit-tap-highlight-color: transparent;
	}

	.gallery .lightbox .lightbox-button:hover,
	.gallery .lightbox .lightbox-button:active {
		background-color: rgba(255, 255, 255, 0.2);
	}

	.gallery .lightbox .lightbox-button:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 2px;
	}

	.gallery .lightbox .lightbox-button svg {
		width: 1.25rem;
		height: 1.25rem;
		stroke: #fff;
	}

	.gallery .lightbox .lightbox-close {
		top: 0.75rem;
		right: 0.75rem;
	}

	.gallery .lightbox .lightbox-prev,
	.gallery .lightbox .lightbox-next {
		top: 50%;
		transform: translateY(-50%);
	}

	.gallery .lightbox .lightbox-prev {
		left: 0.75rem;
	}

	.gallery .lightbox .lightbox-next {
		right: 0.75rem;
	}

	/* 只有一張圖時不需要切換按鈕 */
	.gallery .lightbox.is-single .lightbox-prev,
	.gallery .lightbox.is-single .lightbox-next,
	.gallery .lightbox.is-single .lightbox-counter {
		display: none;
	}

	.gallery .lightbox .lightbox-counter {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 1rem;
		text-align: center;
		font-size: 0.85rem;
		line-height: 1;
		letter-spacing: 0.15em;
		color: rgba(255, 255, 255, 0.75);
		pointer-events: none;
	}

	/* 寬螢幕：兩側留位置給切換按鈕，不要壓在圖上 */
	@media screen and (min-width: 737px) {
		.gallery .lightbox .lightbox-image {
			max-width: calc(100vw - 9rem);
			max-height: calc(100vh - 6rem);
			max-height: calc(100dvh - 6rem);
		}
	}
</style>

<script>
	function setupGallery(root: Element) {
		const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]');
		const image = root.querySelector<HTMLImageElement>('[data-lightbox-image]');
		const counter = root.querySelector<HTMLElement>('[data-lightbox-counter]');
		const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-gallery-item]'));

		// 瀏覽器不支援 <dialog> 時什麼都不做：縮圖仍是一般連結，點了會直接開啟大圖
		if (!dialog || !image || links.length === 0 || typeof dialog.showModal !== 'function') return;

		let current = 0;
		dialog.classList.toggle('is-single', links.length === 1);

		const show = (index: number) => {
			current = (index + links.length) % links.length;
			const link = links[current];
			image.classList.add('is-loading');
			image.src = link.href;
			image.alt = link.querySelector('img')?.alt ?? '';
			if (image.complete) image.classList.remove('is-loading');
			if (counter) counter.textContent = `${current + 1} / ${links.length}`;
		};

		image.addEventListener('load', () => image.classList.remove('is-loading'));
		image.addEventListener('error', () => image.classList.remove('is-loading'));

		links.forEach((link, index) => {
			link.addEventListener('click', (event) => {
				// Ctrl / ⌘ / Shift 點擊時維持瀏覽器原本的「在新分頁開啟」
				if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
				event.preventDefault();
				show(index);
				document.documentElement.style.overflow = 'hidden';
				dialog.showModal();
			});
		});

		dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
		dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
		dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));

		// 點圖片以外的黑色區域關閉（Esc 由瀏覽器處理）
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});

		dialog.addEventListener('close', () => {
			document.documentElement.style.overflow = '';
		});

		dialog.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') show(current - 1);
			if (event.key === 'ArrowRight') show(current + 1);
		});

		// 手機左右滑動切換
		let startX: number | null = null;
		dialog.addEventListener(
			'touchstart',
			(event) => {
				startX = event.touches.length === 1 ? event.touches[0].clientX : null;
			},
			{ passive: true },
		);
		dialog.addEventListener(
			'touchend',
			(event) => {
				if (startX === null) return;
				const distance = event.changedTouches[0].clientX - startX;
				startX = null;
				if (Math.abs(distance) > 50) show(current + (distance < 0 ? 1 : -1));
			},
			{ passive: true },
		);
	}

	document.querySelectorAll('[data-gallery]').forEach(setupGallery);
</script>
