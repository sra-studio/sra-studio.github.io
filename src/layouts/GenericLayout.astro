---
// 一般頁面的版型（專案頁、地圖頁、列表頁、404）：共用骨架加上最上方的標題區塊。
// 用法：<GenericLayout pageTitle={…} mainTitle={…} subTitle={…} description={…} image={…} imagePosition={…}>
//   description、image、imagePosition 可省略。image 會同時用在標題區塊的背景和分享預覽圖；
//   沒有提供時，背景是預設的三人合照。imagePosition 是背景要對準圖片的哪個位置，
//   寫法和 CSS 的 background-position 一樣，例如 "50% 25%"（水平 垂直），預設正中央。
import { getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';

const { pageTitle, mainTitle, subTitle, description, image, imagePosition } = Astro.props;

// 分頁標題：把頁面名稱放最前面，例如「Maze | SRA Studio | Projects」
const fullTitle = mainTitle ? `${mainTitle} | ${pageTitle}` : pageTitle;

// 標題區塊的背景圖：一般螢幕用 1920px，手機用 960px（由 main.css 的 header.has-image 套用）
let headerStyle;
if (image) {
	const large = await getImage({ src: image, width: Math.min(image.width, 1920) });
	const small = await getImage({ src: image, width: Math.min(image.width, 960) });
	headerStyle = `--header-image: url('${large.src}'); --header-image-small: url('${small.src}');`;
	if (imagePosition) headerStyle += ` background-position: ${imagePosition};`;
}

---
<BaseLayout title={fullTitle} description={description} image={image}>

	<!-- Main -->
		<article id="main">
			<header class={image ? 'has-image' : 'default'} style={headerStyle}>
				<h2>{mainTitle}</h2>
				<p>{subTitle}</p>
			</header>

			<slot />

		</article>

</BaseLayout>
