---
// 全站共用的頁面骨架：<head>、頁首選單、頁尾和共用腳本都在這裡，改一次全站生效。
// 頁面不直接用這個檔案，而是用包著它的兩個版型：
//   GenericLayout.astro  一般頁面（上方有標題區塊）
//   HomePageLayout.astro 首頁（大橫幅）
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';

import '../styles/css/main.css';
import noscriptUrl from '../styles/css/noscript.css?url';

// Font Awesome Icons
import '../styles/fontawesome/css/fontawesome.css';
import '../styles/fontawesome/css/brands.css';
import '../styles/fontawesome/css/solid.css';

// Web Icon
import Icon from '../images/icon_64x64.png';
import IconSRA from '../images/icon_sra.png';

// Scripts
import jqueryUrl from '../styles/js/jquery.min.js?url';
import scrollexUrl from '../styles/js/jquery.scrollex.min.js?url';
import scrollyUrl from '../styles/js/jquery.scrolly.min.js?url';
import browserUrl from '../styles/js/browser.min.js?url';
import breakpointsUrl from '../styles/js/breakpoints.min.js?url';
import utilUrl from '../styles/js/util.js?url';
import mainUrl from '../styles/js/main.js?url';

// title：分頁標題；description、image：搜尋與分享預覽用（可省略）；
// bodyClass：加在 <body> 上的額外 class，首頁用 "landing"
const { title, description, image, bodyClass } = Astro.props;

---
<!DOCTYPE HTML>
<!--
	Spectral by HTML5 UP
	html5up.net | @ajlkn
	Free for personal and commercial use under the CCA 3.0 license (html5up.net/license)
-->
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} image={image} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Open+Sans:400,400italic,600,600italic,800,800italic&amp;display=swap">
    <noscript>
		<link rel="stylesheet" href={noscriptUrl} />
	</noscript>

    <!-- Web Icon -->
    <link rel="icon" type="image/png" sizes="32x32" href={Icon.src}>
    <link rel="icon" type="image/png" sizes="16x16" href={Icon.src}>
    <link rel="icon" type="image/png" sizes="180x180" href={IconSRA.src}>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-F7PQGZVBBD"></script>
		<script is:inline>
      		window.dataLayer = window.dataLayer || [];
      		function gtag(){dataLayer.push(arguments);}
      		gtag('js', new Date());

      		gtag('config', 'G-F7PQGZVBBD')
    	</script>

  	</head>
  	<body class={bodyClass ? `${bodyClass} is-preload` : 'is-preload'}>

		<!-- Page Wrapper -->
			<div id="page-wrapper">

				<Header />

				<slot />

				<Footer />

			</div>

		<!-- Copy popup -->
			<div id="copyPopup" class="popup" role="status" aria-live="polite"><span class="icon fa-solid fa-check"></span> 已複製到剪貼簿</div>

		<!-- Scripts -->
			<script is:inline src={jqueryUrl}></script>
			<script is:inline src={scrollexUrl}></script>
			<script is:inline src={scrollyUrl}></script>
			<script is:inline src={browserUrl}></script>
			<script is:inline src={breakpointsUrl}></script>
			<script is:inline src={utilUrl}></script>
			<script is:inline src={mainUrl}></script>

			<!-- Google AdSense -->
			<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2260487722232602"crossorigin="anonymous"></script>

			<!-- Add on -->
			<script>
				import '../styles/js/copyCode.js';
				import '../styles/js/copyText.js';
				import '../styles/js/spoiler-toggle.js';
				import '../styles/js/hide-link.js';
			</script>
	</body>
</html>
